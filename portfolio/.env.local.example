# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email - server-side only; never prefix these with NEXT_PUBLIC_
RESEND_API_KEY=
# Recipient: your valid inbox address
CONTACT_EMAIL=
# Bare sender address on a domain verified in Resend (no display name)
CONTACT_FROM_EMAIL=

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
