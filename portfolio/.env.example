# Optional Supabase data (not used by the contact form)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side Resend key. Never use NEXT_PUBLIC_ for these variables.
RESEND_API_KEY=
# Recipient: your valid inbox address
CONTACT_EMAIL=
# Bare sender address on a domain verified in Resend (no display name)
CONTACT_FROM_EMAIL=
